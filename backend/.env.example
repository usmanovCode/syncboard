# Copy to backend/.env and fill in. backend/.env is git-ignored and loaded by Spring Boot
# (spring.config.import in application.yml), so it must sit in the directory you run the app from.
# Format is Java .properties: KEY=value, no quotes.

DB_URL=jdbc:postgresql://localhost:5432/syncboard
DB_USERNAME=postgres
DB_PASSWORD=

# Database used by `mvnw test` (create it once: createdb -U postgres syncboard_test)
TEST_DB_URL=jdbc:postgresql://localhost:5432/syncboard_test

# At least 32 characters. Generate one, e.g.:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Bash:       openssl rand -base64 48
JWT_SECRET=
# ISO-8601 duration
JWT_TTL=PT1H

CORS_ALLOWED_ORIGINS=http://localhost:5173
